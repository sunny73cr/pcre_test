#!/bin/bash

if test "$1" == "clean"; then
    printf "\033[36mpcre_test\033[39m: Cleaning pcre_test and submodules...\n";

    rm -rf ./build;
    if test $? -ne 0; then printf "\033[31mpcre_test\033[39m: Failed to clean pcre_test...\n">&2; exit 1; fi;

    if test -d ./submodules/pcre2; then
        make -C ./submodules/pcre2/ clean;
        if test $? -ne 0; then printf "\033[31mpcre_test\033[39m: Failed to clean submodules/pcre2...\n">&2; exit 1; fi;
    fi

    exit 0;
fi;

if test ! -d ./submodules/pcre2; then
    printf "\033[31mpcre_test\033[39m: Missing submodule 'pcre2'; run ./configure first!\n">&2;
    exit 1;
fi

printf "\033[36mpcre_test\033[39m: Building submodules/pcre2...\n";

cd ./submodules/pcre2;
if test $? -ne 0; then printf "\033[31mpcre_test\033[39m: Failed to cd into submodules/pcre2...\n">&2; exit 1; fi;

./autogen.sh;
if test $? -ne 0; then printf "\033[31mpcre_test\033[39m: Failed to run 'autogen.sh' in submodules/pcre2, do you have the package 'libtool'?...\n">&2; exit 1; fi;

./configure;
if test $? -ne 0; then printf "\033[31mpcre_test\033[39m: Failed to run 'configure' in submodules/pcre2...\n">&2; exit 1; fi;

if test "$1" == "install"; then
    make install;
    if test $? -ne 0; then printf "\033[31mpcre_test\033[39m: Failed to build submodules/pcre2... installation might require root!\n">&2; exit 1; fi;
else
    make;
    if test $? -ne 0; then printf "\033[31mpcre_test\033[39m: Failed to build submodules/pcre2...\n">&2; exit 1; fi;
fi;

cd ../../;
if test $? -ne 0; then printf "\033[31mpcre_test\033[39m: Failed to 'cd' out of submodules/pcre2...\n">&2; exit 1; fi;

printf "\033[32mpcre_test\033[39m: Built submodules/pcre2!\n";

printf "\033[36mpcre_test\033[39m: Building pcre_test...\n";

if [ ! -d ./build ]; then
    mkdir ./build;
    if test $? -ne 0; then printf "\033[31mpcre_test\033[39m: Failed to make the ./build directory...\n">&2; exit 1; fi;
fi;

# *.c   : input source files.
# -pipe : use pipes instead of intermediate files (memory is faster than disk.)
# -I    : include the headers generated by the pcre2 submodule.
# -L    : indicate to gcc that the libraries to be linked with are (also) in these directories.
# -l    : link with the .so shared object "library" generated by the pcre2 submodule.
# -o    : output to this (executable) binary file.
# Note that it seems to matter if -l is passed prior to the source files, it must be passed after.
if test "$1" == "install"; then
    gcc ./pcre_test.c -pipe -I/usr/local/include -L/usr/local/lib -lpcre2-posix -o ./build/pcre_test
else
    gcc ./pcre_test.c -pipe -I/usr/local/include -L./submodules/pcre2/.libs -lpcre2-posix -o ./build/pcre_test
fi
if [ $? -ne 0 ]; then printf "\033[31mpcre_test\033[39m: Failed to build pcre_test!\n">&2; exit 1; fi;

printf "\033[32mpcre_test\033[39m: Built pcre_test!\n";

if test "$1" == "install"; then
    cp ./build/pcre_test /usr/bin/pcre_test;
    if [ $? -ne 0 ]; then printf "\033[31mpcre_test\033[39m: Failed to install pcre_test to /usr/bin/!\n">&2; exit 1; fi;

    printf "\033[32mpcre_test\033[39m: Installed to '/usr/bin/pcre_test'.\n";
    printf "\033[36mpcre_test\033[39m: You may want to edit ownership and mode.\n";
fi

exit 0;
